# ─── Configuración SMTP para el formulario de contacto ───
# Copiá este archivo como .env y completá los datos.
# El form.php lee estas constantes si existen.
#
# Para Gmail:
#   1. Activá 2FA en tu cuenta de Google
#   2. Generá una App Password: https://myaccount.google.com/apppasswords
#   3. Usá esa App Password acá

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password
SMTP_ENCRYPT=tls
